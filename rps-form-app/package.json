{
  "name": "rps-form-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "start": "npm run start -w apps/api",
    "test": "echo 'Not implemented yet'",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx prisma db seed",
    "template:prepare": "ts-node scripts/prepare-template.ts",
    "doctor": "node scripts/doctor.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.2.2",
    "ts-node": "^10.9.1"
  }
}